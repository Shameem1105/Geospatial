# ==============================================================================
# TerraFlow Backend Environment Configuration (.env)
# ==============================================================================

# Database Connection (MySQL / XAMPP / Remote Cloud MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=terraflow

# CORS Configuration (Comma-separated list of allowed origins)
# For local dev: http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# For production: https://<your-vercel-domain>.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Storage & Upload Limits
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# API Versioning Prefix
API_V1_STR=/api/v1

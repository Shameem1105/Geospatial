# ==============================================================================
# TerraFlow Root Environment Configuration Template
# ==============================================================================

# Backend Database Connection (MySQL / XAMPP / TiDB / PlanetScale / AWS RDS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=terraflow

# Backend CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Backend Storage Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# Frontend API URL Configuration
# For local dev: http://localhost:8000/api/v1
# For Vercel production (same domain): /api/v1 (or leave blank to use relative /api/v1)
# For Vercel production (separate backend): https://<your-backend-domain>/api/v1
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
